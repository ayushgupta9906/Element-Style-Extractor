{
    "manifest_version": 3,
    "name": "Element Style Extractor",
    "version": "1.0",
    "description": "Extract HTML and CSS of any element on the page.",
    "permissions": ["scripting"],
    "host_permissions": ["<all_urls>"],
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_title": "Inject Element Style Extractor"
    }
}
